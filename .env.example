# Required ONLY for live product offers (SerpApi Google Shopping)
SERPAPI_KEY=

# Optional Keenable for policy page research (keyless mode may have different limits)
KEENABLE_API_KEY=

# Optional shared database for public hosting. Set BOTH values, server-side only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Local SQLite fallback
SQLITE_PATH=smartdeal.db
CACHE_HOURS=3

# Optional free local inference (not automatically available on public hosting)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
